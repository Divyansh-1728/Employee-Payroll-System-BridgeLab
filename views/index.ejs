<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Employee Payroll</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>

    <div class="top-bar">
        <div class="logo">
            <i class="fas fa-users-cog"></i> EMPLOYEE PAYROLL
        </div>
        <div class="actions">
            <i class="fas fa-search" style="font-size: 20px; color:#aaa; margin-top: 10px;"></i>
            <a href="/add" class="btn-add">+ Add User</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="card">
            <i class="fas fa-users icon"></i>
            <h3>Total Employees</h3>
            <div class="value"><%= stats.totalEmployees %></div>
        </div>
        <div class="card">
            <i class="fas fa-building icon"></i>
            <h3>Departments</h3>
            <div class="value"><%= stats.uniqueDepts %></div>
        </div>
        <div class="card">
            <i class="fas fa-money-bill-wave icon"></i>
            <h3>Total Basic Salary</h3>
            <div class="value">₹<%= stats.totalBasic %></div>
        </div>
        <div class="card">
            <i class="fas fa-file-invoice-dollar icon"></i>
            <h3>Total Tax (12%)</h3>
            <div class="value">₹<%= stats.totalTax %></div>
        </div>
        <div class="card">
            <i class="fas fa-wallet icon"></i>
            <h3>Total Net Salary</h3>
            <div class="value">₹<%= stats.totalNet %></div>
        </div>
        <div class="card">
            <i class="fas fa-chart-line icon"></i>
            <h3>Average Salary</h3>
            <div class="value">₹<%= stats.avgSalary %></div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Gender</th> <th>Department</th>
                <th>Salary</th>
                <th>Start Date</th> <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (employees.length > 0) { %>
                <% employees.forEach(emp => { %>
                    <tr>
                        <td>
                            <div class="profile-cell">
                                <div class="avatar"><i class="fas fa-user"></i></div>
                                <span><%= emp.name %></span>
                            </div>
                        </td>
                        <td>Unknown</td> <td><span style="background:#e8f5e9; color:#2e7d32; padding:3px 8px; border-radius:10px; font-size:12px;"><%= emp.department %></span></td>
                        <td>₹<%= Number(emp.basicSalary).toLocaleString() %></td>
                        <td>Jan 01, 2024</td> <td>
                            <a href="#" class="action-btn"><i class="fas fa-pen"></i></a>
                            <a href="#" class="action-btn"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="6" style="text-align:center; padding: 20px;">No employees found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

</body>
</html>